# ---- Nobitex credentials -------------------------------------------------
# Nobitex has TWO credential schemes and they are NOT interchangeable.
#
# (a) Login token -- from POST /auth/login/, a hex string. Sent as a bearer
#     header. Set this one OR the pair below, not both.
NOBITEX_API_TOKEN=

# (b) API key pair -- from POST /apikeys/create. Scoped permissions
#     (READ / TRADE / WITHDRAW), optional IP allowlist, optional expiry.
#     NOT a bearer token: every request is signed with Ed25519, so BOTH
#     halves are required. Both are 44-character base64 strings and look
#     identical, so keep them straight -- using the public key alone (or as
#     NOBITEX_API_TOKEN) returns 401 with no explanation.
#
#     The private key is displayed ONLY ONCE, when the key is created.
NOBITEX_API_KEY=
NOBITEX_API_SECRET=

# Constant per-user parameter used to build private websocket channel names,
# e.g. private:trades#<param>.  Read it from GET /users/profile.
NOBITEX_WS_AUTH_PARAM=

# Set to 1 to point every Nobitex call at the testnet.
NOBITEX_TESTNET=0

# ---- Runtime -------------------------------------------------------------
# paper | live   -- `paper` never sends an order to the exchange.
NBTREND_MODE=paper
NBTREND_LOG_LEVEL=INFO
